# Comma-separated target URLs (http/https only)
TARGET_URLS=https://example.com,https://example.org

# Cron schedule (default: top of every hour)
CRON_SCHEDULE=0 * * * *

# Local working directory for temporary screenshots
SCREENSHOT_DIR=/data/screenshots

# Screenshot options
SCREENSHOT_FULL_PAGE=false
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
PAGE_TIMEOUT_MS=30000
EXTRA_WAIT_MS=0
DELETE_LOCAL_AFTER_UPLOAD=true

# Retry behavior
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=10000

# Google Drive mode: appdata (recommended) or visible-folder (optional)
GOOGLE_DRIVE_MODE=appdata
GOOGLE_DRIVE_FOLDER_ID=

# OAuth client credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost/oauth2callback

# Option A: set refresh token directly
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Option B: mount credential/token files and set file paths
# GOOGLE_CREDENTIALS_FILE=/run/secrets/google_credentials.json
# GOOGLE_TOKEN_FILE=/data/tokens/google_token.json

LOG_LEVEL=info
PORT=8080
