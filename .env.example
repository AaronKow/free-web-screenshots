# OAuth client credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://screenshots.example.com/callback

# Optional direct token (if omitted, use hosted setup flow)
GOOGLE_REFRESH_TOKEN=

# Token file for hosted setup and token persistence
GOOGLE_TOKEN_FILE=/data/tokens/google_token.json

# Optional mounted OAuth client JSON from Google Cloud
# GOOGLE_CREDENTIALS_FILE=/run/secrets/google_credentials.json

# Hosted secure setup + callback
OAUTH_SETUP_ENABLED=true
APP_BASE_URL=https://screenshots.example.com
OAUTH_SETUP_PATH=/oauth/start
OAUTH_CALLBACK_PATH=/callback
OAUTH_STATE_SECRET=replace-with-long-random-32-plus-chars

# App login gate for setup/dashboard
APP_USER=admin
APP_PASS=change-me

# Runtime setup persistence written from web form
APP_RUNTIME_CONFIG_FILE=/data/runtime-config.json
APP_RUNTIME_ENV_FILE=/data/runtime.env

# Optional bootstrap defaults (used if runtime config file not created yet)
TARGET_URLS=https://example.com,https://example.org
CRON_SCHEDULE=0 * * * *
SCREENSHOT_DIR=/data/screenshots
# Optional browser JavaScript run before screenshot.
# Return an array of step objects to capture multiple shots in one session.
PRE_SCREENSHOT_SCRIPT=
SCREENSHOT_FULL_PAGE=false
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
PAGE_TIMEOUT_MS=30000
EXTRA_WAIT_MS=0
DELETE_LOCAL_AFTER_UPLOAD=true
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=10000
GOOGLE_DRIVE_MODE=appdata
GOOGLE_DRIVE_FOLDER_ID=

LOG_LEVEL=info
PORT=8080
