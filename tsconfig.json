{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": true,
    "tsBuildInfoFile": ".tmp/tsconfig.tsbuildinfo",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "test"],
  "exclude": ["dist", "node_modules", "tmp"]
}
